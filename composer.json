{
    "name": "iglesia/cms",
    "description": "CMS modular en PHP puro, estilo WordPress, con soporte de plugins y temas",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "nikic/fast-route": "^1.3",
        "catfan/medoo": "^2.1",
        "league/plates": "^3.5",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "symfony/var-dumper": "^6.4"
    },
    "autoload": {
        "psr-4": {
            "Cms\\": "core/",
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "core/Support/helpers.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
