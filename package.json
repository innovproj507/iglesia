{
    "name": "iglesia-cms",
    "private": true,
    "scripts": {
        "dev": "tailwindcss -c tailwind.config.js -i themes/iglesia-base/src/css/app.css -o public/assets/theme/app.css --watch",
        "build:css": "tailwindcss -c tailwind.config.js -i themes/iglesia-base/src/css/app.css -o public/assets/theme/app.css --minify",
        "build:admin-css": "tailwindcss -c tailwind.admin.config.js -i core/Admin/resources/css/admin.css -o public/assets/admin/app.css --minify",
        "build:js": "esbuild themes/iglesia-base/src/js/app.js --bundle --outfile=public/assets/theme/app.js --minify",
        "build": "npm run build:css && npm run build:admin-css && npm run build:js"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.7",
        "@tailwindcss/typography": "^0.5.13",
        "esbuild": "^0.24.0",
        "tailwindcss": "^3.4.0"
    },
    "dependencies": {
        "alpinejs": "^3.14.0"
    }
}
